{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "centerAnchor": "promaa.clock",
    "layout": {
      "left": [
        {
          "id": "workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "promaa.clock",
          "syncIntervalMinutes": 5,
          "notifyMinutesBefore": 5,
          "notifyUpcomingEvents": true,
          "weekStartDay": "monday",
          "format": "ddd d MMM HH:mm",
          "clockHourCycle": 24
        },
        {
          "id": "omarchy.weather"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.dropbox",
          "refreshIntervalSec": 60
        },
        {
          "id": "io.github.brm-src.plugin-control-center"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": []
}
