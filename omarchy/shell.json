{
  "bar": {
    "background": "none",
    "layout": {
      "center": [
        {
          "clockHourCycle": 24,
          "format": "ddd d MMM HH:mm",
          "id": "promaa.clock",
          "notifyMinutesBefore": 5,
          "notifyUpcomingEvents": true,
          "syncIntervalMinutes": 5,
          "weekStartDay": "monday"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.elsewhen",
          "cities": [
            {
              "name": "New York",
              "zone": "America/New_York"
            },
            {
              "name": "Los Angeles",
              "zone": "America/Los_Angeles"
            },
            {
              "name": "Rome",
              "zone": "Europe/Rome"
            }
          ]
        }
      ],
      "left": [
        {
          "id": "workspaces"
        },
        {
          "id": "io.github.iammhador.spotify-pulse",
          "maxWidth": "520"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.dropbox",
          "refreshIntervalSec": 60
        },
        {
          "id": "io.github.brm-src.plugin-control-center"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.power"
        }
      ],
      "tray": []
    },
    "position": "top",
    "id": "yakumy.station"
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [],
  "version": 1
}
